# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — skills de terceros instalados localmente.
# Son herramientas del entorno de trabajo, no código del proyecto, e incluyen
# bytecode de Python (.pyc). Si algún día se agrega config compartida del
# equipo (.claude/settings.json, agentes), esa SÍ puede versionarse.
/.claude/skills/
skills-lock.json

# Entregables y material fuente que no forma parte del sitio
# (firmas de correo, manuales, PDFs para el cliente).
# OJO: hacer respaldo aparte — al no estar en git, viven solo en este equipo.
/_reference/
